# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service Role Key (REQUIRED for server-side API routes)
# ⚠️ KEEP THIS SECRET - Never expose in client-side code!
# Get this from: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: Admin email for sending approval notifications
ADMIN_EMAIL=admin@yourdomain.com

# Optional: Site URL for email links
SITE_URL=http://localhost:3000

# Setup Script Passwords (Optional)
# If not set, random secure passwords will be generated
# ADMIN_PASSWORD=your_secure_admin_password_here
# INVESTOR_PASSWORD=your_secure_investor_password_here
